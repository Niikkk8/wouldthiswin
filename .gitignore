# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.backup-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (managed outside the repo)
/supabase

# design reference, local only
/Would This Win Project 34 storyboard.pdf

# judge sprite previews (npm run judges)
/.judge-previews

# product video: renders, captures and raw footage stay local
/video/out/
/video/node_modules/
/video/.cache/
/video/public/capture/
/video/footage/
/video/.venv/
/video/public/sfx/
/video/public/judges/
/video/public/logo.png
/video/public/reel/
/video/*.log
/video/.dev.log
/video/.bin/
/video/audio/build/
/video/.venv-tts/
/video/**/__pycache__/
/video/audio/voice/takes/*.wav
/video/.claude/skills/
/video/.agents/

# agent scratch and local tooling
.agent/
.claude/

# eval reports (npm run eval)
/evals/out/
