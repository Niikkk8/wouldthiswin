{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.ts", "content/guides/*.mdx", "**/*.test.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "content/**/*.mdx"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
}
