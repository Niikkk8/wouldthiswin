# Copy to .env.local and fill in. Never commit real values.

# GitHub personal access token (fine-grained, public repo read-only is enough)
GITHUB_TOKEN=

# Anthropic API key (model: claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Supabase project (server-side only; service role key must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to salt SHA-256 IP hashes. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Caps checked when a session starts (never mid-session). All reset at midnight UTC.
# Sessions one visitor (salted IP hash) may start per day.
MAX_SESSIONS_PER_USER_PER_DAY=5
# Sessions everyone together may start per day.
MAX_SESSIONS_PER_DAY=300
# Logged model spend per day, in USD, after which no new sessions start.
DAILY_SPEND_LIMIT_USD=20

# Secret Vercel sends to the daily retention job (Authorization: Bearer ...). Any long random string.
# Generate with: openssl rand -base64 32. Set the same value in Vercel's environment variables.
CRON_SECRET=

# Canonical site for copyable links and share cards. Optional; defaults to https://wouldthiswin.com
NEXT_PUBLIC_SITE_URL=

# Local only, never on Vercel: Postgres connection for running supabase/schema.sql by hand.
# DATABASE_URL=

# Local testing only: let the rate limit read x-test-ip. Ignored in production.
# WTW_TEST_IP_HEADER=1

# Groq API key for voice answers (whisper-large-v3-turbo). Without it, answers are typed only.
GROQ_API_KEY=
